# .env

DOCKER_USERNAME=
DB_USER=
DB_PASSWORD=

# .env 파일 (로컬용)
RABBITMQ_URL=amqp:

RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_HOST=localhost
TZ=Asia/Seoul

# .env 파일
# PostgreSQL 연결 문자열: 사용자, 비밀번호, 호스트, 포트, DB이름, 스키마 순
DATABASE_URL=

REDIS_HOST=localhost  # Server 1의 IP 주소 (내부망 권장)
REDIS_PORT=
REDIS_PASSWORD=      # 설정되어 있다면 입력

# 🌟 카카오 REST API 키
# .env 파일
KAKAO_REST_API_KEY=
KAKAO_API_URL=
